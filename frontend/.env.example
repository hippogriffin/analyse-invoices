# Where to send the chosen photo -------------------------------------------
# The analysis backend. It stores the photo in Blob Storage and reads it with
# Document Intelligence, so this service needs no Azure credentials at all.
# When this is empty the UI can capture a photo but cannot submit it.
# It must allow this app's origin: set CORS_ALLOW_ORIGINS in backend/.env.
ANALYSIS_API_BASE_URL=http://localhost:3333

# UI limits ---------------------------------------------------------------
# Used to filter the OS file chooser and to reject an unusable file before
# uploading it. The backend enforces the same rules authoritatively, so keep
# these in step with backend/.env MAX_UPLOAD_BYTES and ALLOWED_CONTENT_TYPES.
MAX_UPLOAD_BYTES=10485760
ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp

# Network -----------------------------------------------------------------
# Where the UI listens. 0.0.0.0 binds every interface so the page is reachable
# from any IP; set HOST=127.0.0.1 to restrict it to the local machine again.
HOST=0.0.0.0
PORT=8000

# Optional: serve behind a proxy (Container Apps ingress)
FORWARDED_ALLOW_IPS=*
