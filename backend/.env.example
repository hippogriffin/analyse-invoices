# Source photo. This service owns storage: the browser posts the photo here and
# this service decides where to put it. The blob name is derived from the
# photo's content hash, so a caller can never name a blob.
STORAGE_ACCOUNT_URL=https://youraccount.blob.core.windows.net
SOURCE_CONTAINER=pictures
# Optional prefix every generated blob name sits under, e.g. 2026.
# Also constrains which blobs this service will read back for analysis.
SOURCE_PREFIX=

# Upload limits. Published on /api/config so the UI can filter its file
# chooser and reject a bad photo early. These are enforced here regardless.
MAX_UPLOAD_BYTES=10485760
ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp

# Results
RESULT_TABLE_NAME=invoices

# Document Intelligence
DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
DOCUMENT_INTELLIGENCE_MODEL=prebuilt-invoice
DOCUMENT_INTELLIGENCE_KEY=
ANALYSIS_TIMEOUT_SECONDS=120

# Background work runs in-process, so a restart strands the current job.
# The status endpoint reports a job stuck in 'processing' this long as failed.

# Authentication: managed_identity (default) or account_key (local testing only)
BLOB_AUTH_METHOD=managed_identity
# Required for a user-assigned identity; leave blank for system-assigned.
AZURE_CLIENT_ID=
AZURE_STORAGE_ACCOUNT_KEY=

# Comma-separated. The UI is served from a different origin, so list it here
# (or use * for a local trial). Credentials cannot be combined with *.
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
